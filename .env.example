# Generate different random values, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep true unless every network client is trusted. Never expose no-auth admin publicly.
ADMIN_AUTH_ENABLED=true
ADMIN_TOKEN=replace-with-independent-random-admin-secret
SUBSCRIPTION_TOKEN=replace-with-independent-random-subscription-secret
# Explicit trusted-LAN opt-in: stable /interface.m3u and /live/... without token.
FIXED_SUBSCRIPTION_ENABLED=false
PUBLIC_BASE=http://localhost:1907
BIND_IP=127.0.0.1
PORT=1907
